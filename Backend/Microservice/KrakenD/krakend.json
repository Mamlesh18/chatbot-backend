{
    "version": 3,
    "name": "KrakenD Multi-route Demo",
    "port": 8080,
    "extra_config": {
      "security/cors": {
        "allow_origins": [
          "*"
        ],
        "allow_methods": [
          "GET",
          "HEAD",
          "POST",
          "OPTIONS",
          "PATCH"
        ],
        "expose_headers": [
          "Content-Length",
          "Content-Type"
        ],
        "allow_headers": [
          "Accept-Language",
          "Authorization",
          "Content-Type"
        ],
        "max_age": "12h",
        "allow_credentials": false,
        "debug": false
      }
    },
    "endpoints": [
      {
        "endpoint": "/extractlinks",
        "method": "POST",
        "input_headers": ["*"],
        "output_encoding": "json",
        "timeout":"50s",
        "backend": [
          {
            "url_pattern": "/extractlinks",
            "method": "POST",
            "host": [
              "http://host.docker.internal:5000"
            ]
          }
        ],
        "extra_config": {
          "plugin/req-resp-modifier": {
            "name": ["custom-modifier-response"]
          },
          "qos/ratelimit/router": {
            "max_rate": 100,
            "every": "1s",
            "client_max_rate": 5,
            "strategy": "ip",
            "capacity": 100,
            "client_capacity": 5
          }
        }
      },
      {
        "endpoint": "/process-links",
        "method": "POST",
        "input_headers": ["*"],
        "output_encoding": "json",
        "timeout":"50s",
